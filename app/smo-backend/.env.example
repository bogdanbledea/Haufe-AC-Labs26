PORT=3000

# Supabase — find these in Project Settings > API
SUPABASE_URL=https://xrzenklgermetjfhecbg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Provider toggle ---
# Set to 'groq' or 'ollama'
LLM_PROVIDER=groq

# --- Groq (used when LLM_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Ollama (used when LLM_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434
# Recommended models:
#   Students (low RAM):  llama3.2:3b
#   M3 Pro 36GB:         qwen2.5-coder:14b
OLLAMA_MODEL=llama3.2:3b

# URL of the smo-ai service
SMO_AI_URL=http://localhost:3100

# Shared secret — must match SMO_AI_SECRET in smo-ai
# Generate with: openssl rand -hex 32
SMO_AI_SECRET=
