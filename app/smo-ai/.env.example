# --- Provider toggle ---
# Set to 'groq' or 'ollama'
LLM_PROVIDER=groq

# --- Groq (used when LLM_PROVIDER=groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# URL of your local Ollama instance
OLLAMA_URL=http://localhost:11434
# Recommended models:
#   Students (low RAM):  llama3.2:3b
#   M3 Pro 36GB:         qwen2.5-coder:14b
OLLAMA_MODEL=llama3.2:3b

PORT=3100

# Shared secret — must match SMO_AI_SECRET in smo-backend
# Generate with: openssl rand -hex 32
SMO_AI_SECRET=sbdajkdbkjwhdajw316t21$$%bdjhsadvajhdvdad
